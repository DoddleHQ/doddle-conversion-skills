  "documentation": "https://docs.doddlehq.com",
  "license": "MIT",
  "keywords": ["conversion", "cro", "ab-testing", "landing-page", "optimization", "marketing"],
  "category": "marketing",
  "tags": ["conversion", "cro", "ab-testing"],
  "skills": "./.claude/skills",
  "agents": "./.claude/agents",
  "main": "README.md",
  "components": {
    "skills": { "path": "./.claude/skills", "count": 30, "ids": "doddle.conv.*" },
    "agents": { "path": "./.claude/agents", "count": 5, "list": ["conversion-strategist", "cro-analyst", "ux-researcher", "experiment-lead", "offer-strategist"] },
    "toolkit": { "path": "./scripts/doddle_conversion", "cli": "dconv", "python": ">=3.9", "dependencies": "stdlib-only" }
